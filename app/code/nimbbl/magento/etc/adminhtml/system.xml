<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="nimbbl" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label><![CDATA[Nimbbl&nbsp;&nbsp;<i>Accept and process multiple payments.</i>]]></label>
                <comment>
                    <![CDATA[<a href="https://nimbbl.biz/" target="_blank">Click here to sign up for Nimbbl account</a>]]>
                </comment>
                <field id="title" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                    <config_path>payment/nimbbl/title</config_path>
                </field>
                <field id="merchant_name_override" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant Name</label>
                    <config_path>payment/nimbbl/merchant_name_override</config_path>
                </field>
                <field id="active" translate="label" type="select" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>payment/nimbbl/active</config_path>
                </field>
                <field id="payment_action" translate="label" type="select" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Payment Action</label>
                    <source_model>Nimbbl\Magento\Model\PaymentAction</source_model>
                    <config_path>payment/nimbbl/payment_action</config_path>
                </field>
                <field id="key_id" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key</label>
                    <comment>**Required (Enter test key ID for testing)**</comment>
                    <config_path>payment/nimbbl/key_id</config_path>
                </field>
                <field id="key_secret" translate="label" type="obscure" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key Secret</label>
                    <comment>**Required (Enter test key secret for testing)**</comment>
                    <config_path>payment/nimbbl/key_secret</config_path>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="environment" translate="label" type="text" sortOrder="7" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Base URL</label>
                    <comment>Nimbbl v3 API base URL. Default: https://api.nimbbl.tech/api/v3  |  QA: https://api-qa1.nimbbl.tech/api/v3</comment>
                    <config_path>payment/nimbbl/environment</config_path>
                </field>
                <field id="enable_webhook" translate="label" type="select" sortOrder="8" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Webhook Enabled</label>
                    <comment>** {{base_url}} Copy the Webhook Url from below **</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <frontend_model>Nimbbl\Magento\Model\WebhookUrl</frontend_model>
                    <config_path>payment/nimbbl/enable_webhook</config_path>
                </field>
                <field id="checkout_mode" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Checkout Mode</label>
                    <comment>Popup opens the Nimbbl overlay inline; Redirect sends the customer to the Nimbbl hosted page.</comment>
                    <source_model>Nimbbl\Magento\Model\Source\CheckoutMode</source_model>
                    <config_path>payment/nimbbl/checkout_mode</config_path>
                </field>
                <field id="checkout_host" translate="label" type="text" sortOrder="11" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Checkout Host (Sonic JS)</label>
                    <comment>Base URL for the Nimbbl Sonic JS checkout module. Default: https://sonic.nimbbl.tech — change only if instructed by Nimbbl support.</comment>
                    <config_path>payment/nimbbl/checkout_host</config_path>
                </field>
                <field id="encrypt_payload" translate="label" type="select" sortOrder="12" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Encrypt Request Payload</label>
                    <comment>When enabled, order-creation payloads sent to Nimbbl are AES-GCM encrypted. Must match the "Encrypt Payload" setting in your Nimbbl dashboard. Requires the Nimbbl SDK (Composer install); ignored on manual/zip installs.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>payment/nimbbl/encrypt_payload</config_path>
                </field>
                <field id="express_checkout" translate="label" type="select" sortOrder="13" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Express Checkout</label>
                    <comment>When enabled, customers can pay with Nimbbl directly from the cart/product page without filling the Magento address form first (address is collected inside the Nimbbl overlay).</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>payment/nimbbl/express_checkout</config_path>
                </field>
                <field id="order_status" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>New Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\Processing</source_model>
                    <config_path>payment/nimbbl/order_status</config_path>
                </field>
                <field id="allowspecific" translate="label" type="allowspecific" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Payment from Applicable Countries</label>
                    <source_model>Magento\Payment\Model\Config\Source\Allspecificcountries</source_model>
                    <config_path>payment/nimbbl/allowspecific</config_path>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="51" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Payment from Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                    <config_path>payment/nimbbl/specificcountry</config_path>
                </field>
                <field id="debug_mode" translate="label" type="select" sortOrder="95" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Debug Logging</label>
                    <comment>When enabled, verbose debug messages are written to var/log/nimbbl.log. Disable in production to reduce log volume.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>payment/nimbbl/debug_mode</config_path>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Sort Order</label>
                    <config_path>payment/nimbbl/sort_order</config_path>
                </field>
            </group>
        </section>
    </system>
</config>
