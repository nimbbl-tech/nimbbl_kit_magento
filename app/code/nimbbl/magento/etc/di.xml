<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\Request\CsrfValidator">
        <plugin name="csrf_validator_skip" type="Nimbbl\Magento\Plugin\CsrfValidatorSkip" />
    </type>

    <virtualType name="NimbblLogger" type="Magento\Framework\Logger\Monolog">
	    <arguments>
	        <argument name="handlers" xsi:type="array">
	            <item name="error" xsi:type="object">Nimbbl\Magento\Model\LogHandler</item>
	        </argument>
	    </arguments>
	</virtualType>

	<type name="Nimbbl\Magento\Controller\Payment\Order">
	    <arguments>
	        <argument name="logger" xsi:type="object">NimbblLogger</argument>
	    </arguments>
	</type>

	<type name="Nimbbl\Magento\Controller\Payment\Webhook">
	    <arguments>
	        <argument name="logger" xsi:type="object">NimbblLogger</argument>
	    </arguments>
	</type>

	<!--
	    Wrap NimbblLogger inside a Magento\Payment\Model\Method\Logger so that
	    PaymentMethod::$_logger (AbstractMethod's protected logger) also writes to
	    var/log/Nimbbl/nimbbl_YYYY_MM_DD.log instead of the default var/log/payment.log.
	-->
	<virtualType name="NimbblPaymentMethodLogger" type="Magento\Payment\Model\Method\Logger">
	    <arguments>
	        <argument name="logger" xsi:type="object">NimbblLogger</argument>
	    </arguments>
	</virtualType>

	<type name="Nimbbl\Magento\Model\PaymentMethod">
	    <arguments>
	        <argument name="logger" xsi:type="object">NimbblPaymentMethodLogger</argument>
	    </arguments>
	</type>
</config>
