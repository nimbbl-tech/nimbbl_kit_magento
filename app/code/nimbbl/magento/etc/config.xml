<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <nimbbl>
                <model>Nimbbl\Magento\Model\PaymentMethod</model>
                <title>Nimbbl</title>
                <merchant_name_override>Magento</merchant_name_override>
                <payment_action>authorize_capture</payment_action>
                <active>0</active>
                <order_status>processing</order_status>
                <environment>https://api.nimbbl.tech</environment>
                <checkout_mode>popup</checkout_mode>
                <express_checkout>0</express_checkout>
                <debug_mode>0</debug_mode>
            </nimbbl>
        </payment>
    </default>
</config>
